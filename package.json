{
	"name": "roblox-ts-workspace",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"build": "pnpm -r build",
		"build-watch": "pnpm --filter @roblox-ts/cli build-watch",
		"devlink": "pnpm run build && pnpm --dir devlink add --global .",
		"update-test-types": "pnpm --filter roblox-ts-workspace --filter roblox-ts-runtime-tests update @rbxts/types --latest --save-exact",
		"test": "pnpm run build && pnpm run test-packages && pnpm run test-compile && pnpm run test-rojo && pnpm run test-run",
		"test-compile": "pnpm run test-typecheck && vp test run --coverage",
		"test-typecheck": "tsc --noEmit -p tests/compiler/tsconfig.json && tsc --noEmit -p packages/luau-ast/tests/tsconfig.json",
		"test-rojo": "rojo build tests -o ./tests/test.rbxl",
		"test-run": "lune run ./tests/runTestsWithLune.luau ./tests/test.rbxl",
		"test-roblox": "pnpm run build && pnpm run test-compile && pnpm run test-rojo && pnpm run run-in-roblox",
		"run-in-roblox": "run-in-roblox --place ./tests/test.rbxl --script ./tests/out/main.server.luau",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"check": "pnpm run lint && pnpm run fmt:check",
		"test-packages": "pnpm --filter @roblox-ts/path-translator --filter @roblox-ts/rojo-resolver --filter @roblox-ts/ts-expose-internals run test"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
		"@rbxts/types": "1.0.950",
		"@roblox-ts/cli": "workspace:*",
		"@roblox-ts/luau-ast": "workspace:*",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.0.4",
		"@types/prompts": "^2.4.9",
		"@types/ts-expose-internals": "workspace:@roblox-ts/ts-expose-internals@5.9.3",
		"@vitest/coverage-istanbul": "4.1.11",
		"chokidar": "^4.0.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"fs-extra": "^11.3.0",
		"roblox-ts": "workspace:*",
		"typescript": "=5.9.3",
		"vite-plus": "0.3.1"
	}
}
