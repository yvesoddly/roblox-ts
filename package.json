{
	"name": "roblox-ts-workspace",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"build": "pnpm --filter roblox-ts build",
		"build-watch": "pnpm --filter roblox-ts build-watch",
		"eslint": "eslint --max-warnings 0",
		"devlink": "pnpm run build && pnpm --dir devlink add --global .",
		"update-test-types": "pnpm --filter roblox-ts-runtime-tests add github:roblox-ts/compiler-types @rbxts/types@latest",
		"test": "pnpm run build && pnpm run test-compile && pnpm run test-rojo && pnpm run test-run",
		"test-compile": "jest --coverage --maxWorkers=100%",
		"test-rojo": "rojo build tests -o ./tests/test.rbxl",
		"test-run": "lune run ./tests/runTestsWithLune.luau ./tests/test.rbxl",
		"test-roblox": "pnpm run build && pnpm run test-compile && pnpm run test-rojo && pnpm run run-in-roblox",
		"run-in-roblox": "run-in-roblox --place ./tests/test.rbxl --script ./tests/out/main.server.luau"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
		"@roblox-ts/luau-ast": "=2.1.0",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/eslint__eslintrc": "^2.1.2",
		"@types/eslint__js": "^8.42.3",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.4",
		"@types/prompts": "^2.4.9",
		"@types/ts-expose-internals": "npm:@roblox-ts/ts-expose-internals@=5.9.3",
		"chokidar": "^4.0.3",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.5.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"fs-extra": "^11.3.0",
		"jest": "^30.0.3",
		"jiti": "^2.4.2",
		"prettier": "^3.6.1",
		"roblox-ts": "workspace:*",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.1",
		"typescript": "=5.9.3",
		"typescript-eslint": "^8.61.1"
	}
}
