{
	"name": "roblox-ts",
	"version": "3.0.0",
	"description": "A TypeScript-to-Luau Compiler for Roblox",
	"main": "out/CLI/index.js",
	"browser": "out/CLI/browser.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/roblox-ts/roblox-ts.git",
		"directory": "packages/roblox-ts"
	},
	"bin": {
		"rbxtsc": "out/CLI/cli.js"
	},
	"scripts": {
		"prepack": "pnpm run build",
		"build": "tspc -b",
		"build-watch": "tspc -b -w"
	},
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@roblox-ts/luau-ast": "=2.1.0",
		"@roblox-ts/path-translator": "=1.1.0",
		"@roblox-ts/rojo-resolver": "=1.2.0",
		"chokidar": "^4.0.3",
		"effect": "4.0.0-rc.112",
		"fs-extra": "^11.3.0",
		"kleur": "^4.1.5",
		"resolve": "^1.22.10",
		"typescript": "=5.9.3",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.0.4",
		"@types/resolve": "^1.20.6",
		"@types/ts-expose-internals": "npm:@roblox-ts/ts-expose-internals@=5.9.3",
		"@types/yargs": "^17.0.33",
		"ts-patch": "^3.3.0",
		"typescript-transform-paths": "^3.5.5"
	},
	"files": [
		"out",
		"include",
		"CHANGELOG.md",
		"!**/*.js.map",
		"!**/*.tsbuildinfo"
	]
}
