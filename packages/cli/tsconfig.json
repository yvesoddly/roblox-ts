{
	"extends": "../roblox-ts/tsconfig-base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		// effect rc.112 has declaration errors; CLI source is still typechecked
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "out",
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"references": [
		{
			"path": "../roblox-ts"
		}
	]
}
