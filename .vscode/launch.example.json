{
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Unit Tests",
			"preLaunchTask": "npm: build",
			"program": "${workspaceFolder}/node_modules/vite-plus/dist/bin.js",
			"args": ["test", "run", "--no-file-parallelism", "--maxWorkers=1"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "demo",
			"preLaunchTask": "npm: build",
			"program": "${workspaceFolder}/packages/roblox-ts/out/CLI/cli.js",
			"cwd": "/path/to/project",
			"args": ["--verbose"],
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
